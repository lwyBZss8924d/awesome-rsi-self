{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "rsi.knowledge-contribution.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "source_manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "generated": {
      "type": "object",
      "properties": {
        "by": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9._-]+\\/[a-zA-Z0-9._-]+$"
        },
        "at": {
          "type": "string"
        }
      },
      "required": [
        "by",
        "at"
      ],
      "additionalProperties": false
    },
    "pages": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "previous_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "frontmatter": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "body": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source_id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9._-]*$"
                },
                "version": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "prepared_manifest": {
                  "type": "string"
                },
                "prepared_manifest_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "artifact": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "locator": {
                  "type": "object",
                  "properties": {
                    "start_line": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "end_line": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "start_line",
                    "end_line"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "source_id",
                "version",
                "prepared_manifest",
                "prepared_manifest_sha256",
                "artifact",
                "sha256",
                "locator"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "path",
          "frontmatter",
          "body",
          "evidence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "source_manifest_sha256",
    "generated",
    "pages"
  ],
  "additionalProperties": false
}
